# Copy to .env and fill in real values. .env is git-ignored. Never put a
# service-role key or a Resend key in a VITE_ variable.

# Required in production: Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# To offer the 24-hour, no-email trial: enable Anonymous Sign-Ins in
# Supabase Dashboard → Authentication → Providers. Enable CAPTCHA/Turnstile
# there as well before publishing, to protect against automated sign-ups.

# Required at build time by the browser to send a passwordless email link.
# This is a public publishable key, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional canonical browser origin. If unset, the app safely uses the current
# HTTPS origin (or localhost/127.0.0.1 during local development).
VITE_APP_ORIGIN=

# Comma-separated, verified Supabase Auth email addresses allowed to open /admin.
ADMIN_EMAILS=

# Optional email delivery for accountant exports and future reminders.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# The AI works with ANY ONE of these keys. The server auto-detects which is set.
# Recommended (free, no credit card, fast): Groq → https://console.groq.com
GROQ_API_KEY=

# Alternatives (pick one):
# MISTRAL_API_KEY=        # https://console.mistral.ai  (free tier, great French)
# OPENROUTER_API_KEY=     # https://openrouter.ai       (has free models)
# GEMINI_API_KEY=         # https://aistudio.google.com (free tier; API must be enabled)
# XAI_API_KEY=            # https://console.x.ai (Grok) — NOT free, needs paid credits added first

# Optional overrides:
# AI_PROVIDER=groq        # force a provider: groq | mistral | openrouter | gemini
# AI_CHAT_MODEL=          # override the chat model
# AI_VISION_MODEL=        # override the scanner (vision) model

# Activation codes are generated server-side, stored in Supabase, and can be
# used only once. There is deliberately no master or owner code.
