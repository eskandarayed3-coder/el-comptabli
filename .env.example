# Copy to .env and fill in real values. .env is git-ignored.
#
# The AI works with ANY ONE of these keys. The server auto-detects which is set.
# Recommended (free, no credit card, fast): Groq → https://console.groq.com
GROQ_API_KEY=

# Alternatives (pick one):
# MISTRAL_API_KEY=        # https://console.mistral.ai  (free tier, great French)
# OPENROUTER_API_KEY=     # https://openrouter.ai       (has free models)
# GEMINI_API_KEY=         # https://aistudio.google.com (free tier; API must be enabled)
# XAI_API_KEY=            # https://console.x.ai (Grok) — NOT free, needs paid credits added first

# Optional overrides:
# AI_PROVIDER=groq        # force a provider: groq | mistral | openrouter | gemini
# AI_CHAT_MODEL=          # override the chat model
# AI_VISION_MODEL=        # override the scanner (vision) model

# Premium activation codes (server-side only — never shipped to the browser):
# CODE_SALT=<random>      # signs activation codes; keep secret, change once
# ADMIN_SECRET=<random>   # protects the code generator: /api/activate/gen?secret=...&plan=mois&n=10
# MASTER_CODE=88888888    # evergreen code granting a month pass (set to "off" to disable)
